# Configuración de integración con N8N
VITE_N8N_ENABLED=true

# Webhook Base URL para el Chatbot con Gemini en N8N
VITE_N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
VITE_USE_GEMINI_WORKFLOW=true

# Webhooks de N8N enrutados por proxy Vite (elimina errores de CORS)
VITE_N8N_WEBHOOK_REGISTRO=/n8n-proxy/webhook-test/artlink-registro-usuario
VITE_N8N_WEBHOOK_SOLICITUD=/n8n-proxy/webhook-test/artlink-solicitud-comision

# URL del servidor interno de datos (JSON Server)
VITE_API_URL=http://localhost:3000
